# development | production
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor_ai

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-too

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60

# console | eskiz
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Faqat development: OTP kod API javobida qaytadi (ilovani SMSsiz sinash uchun)
OTP_DEV_ECHO=true

# Guruh taklif havolasi (QR va "Ulashish" uchun)
PUBLIC_JOIN_URL=https://mentorai.uz/join

# AI: gemini | anthropic | fake (fake = kalitsiz sinov, namunaviy natija)
AI_PROVIDER=fake
# Bepul kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Claude uchun (ixtiyoriy)
ANTHROPIC_API_KEY=
