# ===== Mentor AI — production sozlamalari =====
# Nusxa oling: cp .env.production.example .env   (.env hech qachon git'ga qo'shilmaydi)

# Server domeni (DNS A-yozuvi server IP'siga qaratilgan bo'lishi kerak), masalan api.mentorai.uz
DOMAIN=api.example.uz

# Kuchli parollar: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
OTP_SECRET=

OTP_DEV_ECHO=false

# SMS provayder ulanmaguncha: disabled (faqat email orqali kirish)
SMS_PROVIDER=disabled
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Email orqali kod (Gmail: 2 bosqichli himoya + "App password")
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Mentor AI

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite

TRIAL_DAYS=14
PUBLIC_JOIN_URL=https://mentorai.uz/join
